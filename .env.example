# Backend base URL (sparsh-medical-be). Leave EMPTY when the frontend and API are
# served from the same origin (nginx proxies /api and /media — see nginx.conf)
# or when using VITE_DEV_PROXY below.
VITE_API_BASE_URL=http://localhost:8000

# Dev only: proxy /api and /media to this backend from the Vite dev server.
# VITE_DEV_PROXY=http://localhost:8000

# Google OAuth Web client id — the SAME value as the backend's GOOGLE_CLIENT_ID.
# Add this site's URL (e.g. http://localhost:5173) to the client's
# "Authorized JavaScript origins" in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
